{
  "name": "tadbeergo-crossplatform",
  "version": "1.0.0",
  "description": "TadbeerGo Multi-Platform App for Android, iOS, Windows, macOS and Linux",
  "main": "electron/main.js",
  "author": "TadbeerGo <info@tadbeergo.vercel.app>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "cap:sync": "cap sync",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder --publish never",
    "desktop:dist:mac": "electron-builder --mac --publish never",
    "desktop:dist:win": "electron-builder --win --publish never",
    "desktop:dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.tadbeergo.desktop",
    "productName": "TadbeerGo",
    "publish": null,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "icon-512.png",
      "icon.icns",
      "icon.ico"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "maintainer": "info@tadbeergo.vercel.app",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "icon-512.png"
    }
  }
}
